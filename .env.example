# Database
DATABASE_URL="your_database_url_here"

# NextAuth
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# App
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="SSV Shop POS"
APP_ENV="development"

# Flutterwave (Payment Gateway)
# FLW_PUBLIC_KEY is deprecated - use NEXT_PUBLIC_FLW_PUBLIC_KEY instead
NEXT_PUBLIC_FLW_PUBLIC_KEY="your_flutterwave_public_key"
FLW_SECRET_KEY="your_flutterwave_secret_key"
FLW_SECRET_HASH="your_flutterwave_webhook_secret_hash"

# Termii (SMS Gateway)
TERMII_API_KEY="your_termii_api_key"

# Google Maps (Shipping Calculator)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Seed (for development data seeding)
SEED_SECRET="your_seed_secret_here"
