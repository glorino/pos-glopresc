# Database
DATABASE_URL="your_database_url_here"

# NextAuth
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# App
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="SSV Shop POS"
APP_ENV="development"

# Flutterwave (Payment Gateway)
NEXT_PUBLIC_FLW_PUBLIC_KEY="your_flutterwave_public_key"
FLW_SECRET_KEY="your_flutterwave_secret_key"
FLW_SECRET_HASH="your_flutterwave_webhook_secret_hash"

# Termii (SMS Gateway)
TERMII_API_KEY="your_termii_api_key"

# Google Maps (Shipping Calculator) - server-side only, keep private (use as "Config" on Vercel)
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Seed (for development data seeding)
SEED_SECRET="your_seed_secret_here"

# Encryption (AES-256-CBC for sensitive data like API keys at rest)
ENCRYPTION_KEY="your_64_char_hex_encryption_key_here"

# Stock Alert Threshold
STOCK_ALERT_THRESHOLD="10"
