generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Branches ─────────────────────────────────────────────
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  products         Product[]
  finishedProducts FinishedProduct[]
  sales            Sale[]
  expenses         Expense[]
  shifts           Shift[]
  budgets          Budget[]
   damageReports    DamageReport[]
   wasteReports     WasteReport[]
}

// ── Users & Auth ──────────────────────────────────────────
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  firstName        String
  lastName         String
  phone            String?
  role             UserRole
  avatar           String?
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  branchId         String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  permissions      UserPermission[]
  auditLogs        AuditLog[]
  sales            Sale[]
  cashDrawer       CashDrawer[]
  expenses         Expense[]
  expenseApprovals ExpenseApproval[]
  notifications    Notification[]
  stockAdjustments StockAdjustment[]
  shifts           Shift[]
  assignedTickets  SupportTicket[]
  branch           Branch?           @relation(fields: [branchId], references: [id])

  createdPurchaseOrders   PurchaseOrder[]   @relation("PurchaseOrderCreator")
  approvedExpenses        Expense[]         @relation("ExpenseApprover")
  approvedAdjustments     StockAdjustment[] @relation("AdjustmentApprover")
  createdFinishedProducts FinishedProduct[] @relation("FinishedProductCreator")
  supplyRequests          SupplyRequest[]   @relation("SupplyRequestor")
  leaveRequests           LeaveRequest[]
  approvedLeaves          LeaveRequest[]    @relation("ApprovedLeaves")
  attendance              Attendance[]
   damageReports           DamageReport[]
   wasteReports            WasteReport[]
   incidents               Incident[]

  @@index([role])
  @@index([email])
}

enum UserRole {
  OWNER
  MANAGER
  WAREHOUSE_MANAGER
  WAREHOUSE_REP
  PROCUREMENT_MANAGER
  PROCUREMENT_REP
  SALES_MANAGER
  SALES_REP
  ACCOUNTANT
  AUDITOR
  CUSTOMER
  CFO
  HR_MANAGER
  CHIEF_CHEF
  CASHIER
  BUSINESS_CONTINUITY_MANAGER
  BUSINESS_EFFICIENCY_MANAGER
}

model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  action    String
  resource  String
  granted   Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, action, resource])
}

// ── Categories ────────────────────────────────────────────
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products         Product[]
  finishedProducts FinishedProduct[]

  @@index([name])
}

// ── Suppliers ─────────────────────────────────────────────
model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String   @default("Nigeria")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products       Product[]
  purchaseOrders PurchaseOrder[]
  supplyRequests SupplyRequest[]

  @@index([name])
}

// ── Products ──────────────────────────────────────────────
model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String   @unique
  barcode       String?
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  costPrice     Decimal  @default(0) @db.Decimal(10, 2)
  stockQuantity Int      @default(0)
  minStockLevel Int      @default(5)
  maxStockLevel Int      @default(1000)
  unit          String   @default("piece")
  image         String?
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  isRawMaterial Boolean  @default(false)
  categoryId    String?
  supplierId    String?
  branchId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category           Category?           @relation(fields: [categoryId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  branch             Branch?             @relation(fields: [branchId], references: [id])
  saleItems          SaleItem[]
  cartItems          CartItem[]
  stockAdjustments   StockAdjustment[]
  purchaseOrderItems PurchaseOrderItem[]
  reviews            ProductReview[]
   DamageReport       DamageReport[]
   wasteReports       WasteReport[]

  @@index([sku])
  @@index([name])
  @@index([categoryId])
}

model FinishedProduct {
  id               String   @id @default(cuid())
  name             String
  sku              String   @unique
  description      String?
  quantityProduced Int      @default(0)
  unitCost         Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice     Decimal  @default(0) @db.Decimal(10, 2)
  stockQuantity    Int      @default(0)
  minStockLevel    Int      @default(5)
  unit             String   @default("piece")
  image            String?
  isActive         Boolean  @default(true)
  addedToStore     Boolean  @default(false)
  categoryId       String?
  branchId         String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  creator  User?     @relation("FinishedProductCreator", fields: [createdBy], references: [id])

  @@index([sku])
  @@index([name])
  @@index([categoryId])
  @@index([branchId])
}

// ── Customers ─────────────────────────────────────────────
model Customer {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String?  @unique
  phone         String?
  address       String?
  city          String?
  state         String?
  notes         String?
  loyaltyPoints Int      @default(0)
  totalSpent    Decimal  @default(0) @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales          Sale[]
  bookings       Booking[]
  invoices       Invoice[]
  payments       Payment[]
  reviews        ProductReview[]
  supportTickets SupportTicket[]
  shipments      Shipment[]

  @@index([email])
  @@index([phone])
}

// ── Cart ──────────────────────────────────────────────────
model CartItem {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  quantity  Int      @default(1)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sessionId, productId])
  @@index([sessionId])
  @@index([productId])
}

// ── Sales ─────────────────────────────────────────────────
model Sale {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  userId          String
  customerId      String?
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  tax             Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(10, 2)
  changeDue       Decimal       @default(0) @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  txRef           String?
  status          SaleStatus    @default(COMPLETED)
  notes           String?
  shippingAddress String?
  branchId        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     SaleItem[]
  payments  Payment[]
  refunds   Refund[]
  shipments Shipment[]
  invoiceId String?    @unique
  invoice   Invoice?   @relation(fields: [invoiceId], references: [id])
  branch    Branch?    @relation(fields: [branchId], references: [id])

  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([userId])
  @@index([customerId])
  @@index([branchId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  USSD
  MOBILE
  ONLINE
}

enum SaleStatus {
  PENDING
  COMPLETED
  RETURNED
  REFUNDED
  CANCELLED
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ── Payments ──────────────────────────────────────────────
model Payment {
  id          String        @id @default(cuid())
  saleId      String?
  customerId  String?
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod
  reference   String?       @unique
  description String?
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sale     Sale?     @relation(fields: [saleId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  refunds  Refund[]

  @@index([reference])
  @@index([saleId])
  @@index([customerId])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ── Cash Drawer ───────────────────────────────────────────
model CashDrawer {
  id             String       @id @default(cuid())
  userId         String
  openingBalance Decimal      @db.Decimal(10, 2)
  closingBalance Decimal?     @db.Decimal(10, 2)
  actualBalance  Decimal?     @db.Decimal(10, 2)
  difference     Decimal?     @db.Decimal(10, 2)
  notes          String?
  status         DrawerStatus @default(OPEN)
  openedAt       DateTime     @default(now())
  closedAt       DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([openedAt])
  @@index([userId])
  @@index([status])
}

enum DrawerStatus {
  OPEN
  CLOSED
}

// ── Expenses ──────────────────────────────────────────────
model Expense {
  id          String        @id @default(cuid())
  userId      String
  categoryId  String
  description String
  amount      Decimal       @db.Decimal(10, 2)
  date        DateTime      @default(now())
  receipt     String?
  status      ExpenseStatus @default(PENDING)
  approvedBy  String?
  notes       String?
  branchId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  category  ExpenseCategory   @relation(fields: [categoryId], references: [id])
  approvals ExpenseApproval[]
  invoice   Invoice?
  branch    Branch?           @relation(fields: [branchId], references: [id])
  approver  User?             @relation("ExpenseApprover", fields: [approvedBy], references: [id])

  @@index([date])
  @@index([status])
  @@index([userId])
  @@index([categoryId])
  @@index([branchId])
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  expenses Expense[]
}

model ExpenseApproval {
  id        String         @id @default(cuid())
  expenseId String
  userId    String
  status    ApprovalStatus
  notes     String?
  createdAt DateTime       @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Invoices ──────────────────────────────────────────────
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String?
  expenseId     String?       @unique
  amount        Decimal       @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime
  paidDate      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  expense  Expense?  @relation(fields: [expenseId], references: [id])
  sale     Sale?

  @@index([invoiceNumber])
  @@index([status])
  @@index([customerId])
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ── Bookings ──────────────────────────────────────────────
model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  customerId    String
  serviceType   String
  description   String?
  date          DateTime
  time          String
  duration      Int           @default(60)
  status        BookingStatus @default(PENDING)
  notes         String?
  totalAmount   Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([date])
  @@index([status])
  @@index([customerId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ── Notifications ─────────────────────────────────────────
model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ── Audit Log ─────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ── Settings ──────────────────────────────────────────────
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ── Purchase Orders ───────────────────────────────────────
model PurchaseOrder {
  id           String         @id @default(cuid())
  orderNumber  String         @unique
  supplierId   String
  total        Decimal        @db.Decimal(10, 2)
  status       PurchaseStatus @default(PENDING)
  expectedDate DateTime?
  notes        String?
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  creator  User                @relation("PurchaseOrderCreator", fields: [createdBy], references: [id])

  @@index([orderNumber])
  @@index([status])
  @@index([supplierId])
  @@index([createdBy])
}

enum PurchaseStatus {
  PENDING
  APPROVED
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Decimal @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)
  receivedQty     Int     @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ── Stock Adjustments ─────────────────────────────────────
model StockAdjustment {
  id         String           @id @default(cuid())
  productId  String
  userId     String
  type       AdjustmentType
  quantity   Int
  reason     String
  reference  String?
  status     AdjustmentStatus @default(APPROVED)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime         @default(now())

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id])
  approver User?   @relation("AdjustmentApprover", fields: [approvedBy], references: [id])

  @@index([productId])
  @@index([status])
}

enum AdjustmentType {
  ADDITION
  SUBTRACTION
  DAMAGE
  EXPIRED
  RETURN
  TRANSFER
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Supply Requests ───────────────────────────────────────
model SupplyRequest {
  id           String              @id @default(cuid())
  supplierId   String
  requestedBy  String
  description  String
  status       SupplyRequestStatus @default(PENDING)
  urgency      Urgency             @default(NORMAL)
  expectedDate DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier  Supplier @relation(fields: [supplierId], references: [id])
  requestor User?    @relation("SupplyRequestor", fields: [requestedBy], references: [id])

  @@index([supplierId])
  @@index([status])
  @@index([requestedBy])
}

enum SupplyRequestStatus {
  PENDING
  APPROVED
  ORDERED
  RECEIVED
  CANCELLED
}

enum Urgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ── Refunds ─────────────────────────────────────────────
model Refund {
  id          String   @id @default(cuid())
  saleId      String
  paymentId   String?
  amount      Decimal  @db.Decimal(10, 2)
  reason      String?
  status      String   @default("PENDING")
  processedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sale    Sale     @relation(fields: [saleId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([saleId])
  @@index([paymentId])
}

// ── Webhooks ───────────────────────────────────────────
model Webhook {
  id        String   @id @default(cuid())
  event     String
  source    String
  payload   Json
  status    String   @default("RECEIVED")
  error     String?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([source])
}

// ── Shifts ─────────────────────────────────────────────
model Shift {
  id          String    @id @default(cuid())
  userId      String
  branchId    String?
  startTime   DateTime  @default(now())
  endTime     DateTime?
  status      String    @default("ACTIVE")
  totalSales  Decimal?  @db.Decimal(10, 2)
  totalOrders Int?      @default(0)
  createdAt   DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([userId])
  @@index([branchId])
}

// ── Promotions ─────────────────────────────────────────
model Promotion {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String
  value       Decimal  @db.Decimal(10, 2)
  minAmount   Decimal? @db.Decimal(10, 2)
  startDate   DateTime
  endDate     DateTime
  active      Boolean  @default(true)
  usageCount  Int      @default(0)
  maxUsage    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([startDate, endDate])
}

// ── Support Tickets ────────────────────────────────────
model SupportTicket {
  id         String   @id @default(cuid())
  customerId String
  subject    String
  message    String
  status     String   @default("OPEN")
  priority   String   @default("NORMAL")
  assigneeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  assignee User?    @relation(fields: [assigneeId], references: [id])

  @@index([customerId])
  @@index([assigneeId])
  @@index([status])
}

// ── Product Reviews ────────────────────────────────────
model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  customerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([productId, customerId])
  @@index([productId])
}

// ── Leave Requests ──────────────────────────────────────
model LeaveRequest {
  id         String   @id @default(cuid())
  userId     String
  type       String // ANNUAL, SICK, PERSONAL, MATERNITY, PATERNITY
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User  @relation(fields: [userId], references: [id])
  approver User? @relation("ApprovedLeaves", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([status])
}

// ── Attendance ──────────────────────────────────────────
model Attendance {
  id        String    @id @default(cuid())
  userId    String
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  status    String    @default("ACTIVE") // ACTIVE, ClockedOut
  notes     String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([clockIn])
}

// ── Budgets ─────────────────────────────────────────────
model Budget {
  id        String   @id @default(cuid())
  name      String
  category  String? // DEPARTMENT, CATEGORY, PROJECT
  amount    Decimal  @db.Decimal(10, 2)
  spent     Decimal  @default(0) @db.Decimal(10, 2)
  period    String // MONTHLY, QUARTERLY, YEARLY
  startDate DateTime
  endDate   DateTime
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([period])
}

// ── Damage Reports ──────────────────────────────────────
model DamageReport {
  id         String   @id @default(cuid())
  productId  String
  quantity   Int
  reason     String
  severity   String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  reportedBy String
  branchId   String?
  photoUrl   String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product @relation(fields: [productId], references: [id])
  reporter User    @relation(fields: [reportedBy], references: [id])
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([productId])
  @@index([reportedBy])
}

// ── Waste Reports ───────────────────────────────────────
model WasteReport {
  id          String   @id @default(cuid())
  productId   String
  quantity    Int
  reason      String   // EXPIRED, DAMAGED, SPOILED, OVERCOOKED, OTHER
  reportedBy  String
  branchId    String?
  notes       String?
  createdAt   DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  reporter User     @relation(fields: [reportedBy], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])

  @@index([productId])
  @@index([reportedBy])
}

// ── BCM: Incidents ──────────────────────────────────────
model Incident {
  id          String   @id @default(cuid())
  title       String
  description String?
  severity    String   // LOW, MEDIUM, HIGH, CRITICAL
  status      String   @default("REPORTED") // REPORTED, IN_PROGRESS, MONITORING, RESOLVED
  reportedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User @relation(fields: [reportedBy], references: [id])

  @@index([status])
  @@index([severity])
}

// ── BCM: Risk Assessments ───────────────────────────────
model RiskAssessment {
  id           String   @id @default(cuid())
  area         String
  riskLevel    String   // LOW, MEDIUM, HIGH, CRITICAL
  score        Int
  lastAssessed DateTime @default(now())
  status       String   @default("ACTIVE") // ACTIVE, MONITORED, MITIGATED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([riskLevel])
}

// ── BEM: KPIs ───────────────────────────────────────────
model KPI {
  id       String  @id @default(cuid())
  name     String
  target   Float
  current  Float
  unit     String  @default("count")
  status   String  @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  trend    String  @default("STABLE") // UP, DOWN, STABLE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ── BEM: Process Improvements ───────────────────────────
model ProcessImprovement {
  id          String   @id @default(cuid())
  process     String
  description String
  status      String   @default("PROPOSED") // PROPOSED, IN_PROGRESS, COMPLETED
  impact      String   @default("LOW") // LOW, MEDIUM, HIGH
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// ── Shipments ───────────────────────────────────────────
model Shipment {
  id                String    @id @default(cuid())
  saleId            String?
  customerId        String?
  carrier           String?
  trackingNumber    String?
  status            String    @default("PENDING") // PENDING, SHIPPED, IN_TRANSIT, DELIVERED, RETURNED
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sale     Sale?     @relation(fields: [saleId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([saleId])
  @@index([customerId])
  @@index([status])
}
